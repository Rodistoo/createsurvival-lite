{
  "multipart": [
    { "apply": { "model": "createsurvival_core:block/beam_center" } },
    { "when": { "connect_x": true }, "apply": { "model": "createsurvival_core:block/beam_edges", "y": 90 } },
    { "when": { "connect_y": true }, "apply": { "model": "createsurvival_core:block/beam_edges", "x": 90 } },
    { "when": { "connect_z": true }, "apply": { "model": "createsurvival_core:block/beam_edges" } }
  ]
}
